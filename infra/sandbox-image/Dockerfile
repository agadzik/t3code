# T3 Code agent sandbox image.
#
# Built and pushed to Vercel Container Registry by scripts/build-sandbox-image.ts
# as `t3code-agent:latest`. Every fx thread sandbox boots from this image (or a
# per-project snapshot taken from it), so it carries everything a runner and
# the agent's shell commands need and nothing that holds a credential.
#
# Build context is this directory. The runner bundle under ./runner is
# generated by `vp run --filter @t3tools/fx-runner bundle` and copied here by
# the build script; it is gitignored.
#
# The base image (github.com/vercel/sandbox, images/node) runs as `ubuntu`
# with HOME=/vercel, has git and pnpm, and Vercel ignores ENTRYPOINT/CMD:
# the server starts the runner with `sandbox.runCommand` after boot. It is
# only served by VCR, so a plain `docker build` needs `docker login
# vcr.vercel.com` first; `vercel vcr build` logs in by itself.
FROM vcr.vercel.com/vercel/sandbox/node:24

ARG FX_VERSION=latest
ARG VERCEL_CLI_VERSION=54

USER root
ENV HOME=/root

RUN apt-get update \
  && apt-get install -y --no-install-recommends ca-certificates curl \
  && rm -rf /var/lib/apt/lists/*

# fx CLI. The npm package named `fx` is an unrelated JSON viewer; the Vercel fx
# CLI ships through https://fx.sh/setup.sh, which accepts a pinned version.
RUN curl -fsSL https://fx.sh/setup.sh -o /tmp/fx-setup.sh \
  && if [ "$FX_VERSION" = "latest" ]; then FX_INSTALL_DIR=/usr/local/bin bash /tmp/fx-setup.sh; \
     else FX_INSTALL_DIR=/usr/local/bin bash /tmp/fx-setup.sh "$FX_VERSION"; fi \
  && rm /tmp/fx-setup.sh \
  && fx --version

# vercel CLI for the agent, plus bun so every INSTALL_COMMANDS entry in
# apps/server/src/sandbox/ProjectSandboxImages.ts can run (pnpm is in the base).
RUN npm install -g --no-audit --no-fund "vercel@${VERCEL_CLI_VERSION}" bun \
  && npm cache clean --force \
  && vercel --version

# The fx runner: one bundled entrypoint plus `libfx`, installed here so its
# linux-x64 native addon and wasm files sit where the package expects them.
# The import check fails the build if the addon cannot load on this platform.
COPY runner/ /opt/t3code/fx-runner/
RUN cd /opt/t3code/fx-runner \
  && npm install --omit=dev --no-audit --no-fund \
  && npm cache clean --force \
  && node --input-type=module -e "await import('libfx/node'); console.log('libfx addon loads')" \
  && chmod -R a+rX /opt/t3code

RUN mkdir -p /vercel/sandbox && chown -R ubuntu:ubuntu /vercel

ENV HOME=/vercel
USER ubuntu
WORKDIR /vercel/sandbox
